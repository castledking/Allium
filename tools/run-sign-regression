#!/usr/bin/env python3
"""Required S21 portion of the fixed-artifact regression sweep; sequential owned lanes."""
import argparse
from pathlib import Path
import subprocess
import sys
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--allium-jar',required=True,type=Path)
p.add_argument('--sha256',required=True)
p.add_argument('--run-prefix',required=True)
a,rest=p.parse_known_args()
if any(v in rest for v in ['--suite','--run-name','--signs','--paid-workflows','--signs-piston-only']):
    p.error('suite/run-name/mode are owned by the regression wrapper')
harness=Path(__file__).resolve().parents[1]/'tests/live/economy/run.py'
for lane in ['spigot','paper']:
    subprocess.run([sys.executable,str(harness),'--suite',lane,'--signs','--allium-jar',str(a.allium_jar.resolve()),'--sha256',a.sha256,'--run-name',a.run_prefix+'-signs-'+lane,*rest],check=True)
