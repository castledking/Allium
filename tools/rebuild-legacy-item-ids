#!/usr/bin/env python3
"""Rebuild numeric defaults from the native Essentials/Bukkit conversion fixture.

The input JSON is essentials-converted-ids.json emitted by tests/live/parity/run.py
on Spigot 1.20.1. Alias text is preserved byte-for-byte; it is never reverse-guessed
from a substring of a modern name. See docs/legacy-items-and-teleport.md.
"""
import argparse, gzip, hashlib, json
from pathlib import Path
import yaml
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('converted',type=Path)
a=p.parse_args()
root=Path(__file__).resolve().parents[1]
resource=root/'src/main/resources/itemdb.yml.gz'
original=gzip.decompress(resource.read_bytes()).decode().replace('\r\n','\n')
old=yaml.safe_load(original)['legacy-ids']
mapping=json.loads(a.converted.read_text())
if len(mapping)<750 or mapping.get('1:2')!='POLISHED_GRANITE':raise SystemExit('incomplete native conversion export')
# Legacy potion bit flags encode extended/level II. Bukkit Potion#getEffects()
# returns only the base effects, so retain these flags explicitly in our DSL.
for key,value in list(mapping.items()):
    item,data=map(int,key.split(':'))
    if item==373:
        carrier='SPLASH_POTION' if data&0x4000 else 'POTION'
        if data in (0,16,32,64):
            mapping[key]=carrier+';'+{0:'water',16:'awkward',32:'thick',64:'mundane'}[data]
        elif len(value.split(';'))==4:
            _,effect,_,_=value.split(';')
            effect={'SPEED':'swiftness','JUMP':'leaping','REGENERATION':'regeneration','REGEN':'regeneration','SLOW':'slowness','INSTANT_HEAL':'healing','HEAL':'healing','INSTANT_DAMAGE':'harming','HARM':'harming'}.get(effect,effect.lower())
            prefix='long_' if data&0x40 else 'strong_' if data&0x20 else ''
            mapping[key]=carrier+' potion:'+prefix+effect
    # Essentials' legacy spawner path accepts the same EntityType numeric IDs.
    if item==383 and value.endswith('_SPAWN_EGG'):
        mapping[f'52:{data}']='SPAWNER;'+value.removesuffix('_SPAWN_EGG')
previous=root/'src/main/resources/itemdb-legacy-ids-v1.yml'
if not previous.exists():previous.write_text('# Original numeric defaults, used only to preserve customizations during upgrade.\n'+yaml.safe_dump({'legacy-ids':old},sort_keys=False))
header=original.split('\nlegacy-ids:',1)[0].split('\n# Essentials items.csv numeric pairs;',1)[0].rstrip()
body=header+'\n\n# Essentials items.csv numeric pairs; modern material conversion: Bukkit 1.20.1.\n'+yaml.safe_dump({'legacy-ids':dict(sorted(mapping.items(),key=lambda e:tuple(map(int,e[0].split(':')))))},sort_keys=False)
resource.write_bytes(gzip.compress(body.encode(),mtime=0))
print(f'Wrote {len(mapping)} numeric mappings; alias section preserved; SHA256 {hashlib.sha256(resource.read_bytes()).hexdigest()}')
