#!/usr/bin/env python3
"""Read frozen latency evidence; correlate engine phases, GC pauses and PASSIVE probes without modifying runs."""
import argparse, datetime, hashlib, json, re
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--run',type=Path,action='append',required=True)
p.add_argument('--threshold-ms',type=float,default=500)
p.add_argument('--tolerance-ms',type=float,default=2)
a=p.parse_args()
def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def percentile(xs):
 xs=sorted(xs)
 return dict(n=len(xs),**{name:xs[int((len(xs)-1)*q)] for name,q in [('p50',.5),('p95',.95),('p99',.99),('p999',.999)]},max=xs[-1]) if xs else {}
def overlaps(start,end,x,y):return start<=y+a.tolerance_ms and x<=end+a.tolerance_ms
out={'thresholdMs':a.threshold_ms,'clockToleranceMs':a.tolerance_ms,'scope':'Core phases time JDBC execute methods only; commit includes SQLite sync path but does not isolate physical fsync. GC/probe overlap is correlation. Outer envelope conservatively places uninstrumented adapter/observer time before or after core scope.','runs':[]}
for run in a.run:
 manifest=run/'manifest.json';m=json.loads(manifest.read_text());suite=m['suite'];gcfile=run/(suite+'-economy/gc.log');gcs=[]
 for line in gcfile.read_text().splitlines():
  match=re.match(r'\[([^\]]+)\].*?GC\((\d+)\).*? Pause .*? ([\d.]+)ms$',line)
  if match:
   end=datetime.datetime.fromisoformat(match[1]).timestamp()*1000;duration=float(match[3]);gcs.append(dict(startEpochMillis=end-duration,endEpochMillis=end,durationMs=duration,line=line))
 result=dict(run=str(run),passed=m['passed'],artifactSha256=m['alliumSha256'],manifestSha256=digest(manifest),gcLog=str(gcfile),gcSha256=digest(gcfile),machine=m['machine'],phases={})
 for mode in ['pooled','dedicated']:
  raw=run/f'realistic-{mode}-raw.json';data=json.loads(raw.read_text());samples=data['timings'];observed=m['observations'][suite+'-economy-realistic-'+mode]
  reads=sum(s['kind']=='READ' for s in samples);writes=sum(s['kind'] in ('DEPOSIT','WITHDRAW') for s in samples)
  exact=reads==len(data['readCallsMs']) and writes==len(data['writeCallsMs']) and len(samples)==reads+writes
  counters={'READ':0,'WRITE':0};events=[]
  for s in samples:
   key='READ' if s['kind']=='READ' else 'WRITE';i=counters[key];counters[key]+=1
   total=s['totalNanos']/1e6;outer=(data['readCallsMs'] if key=='READ' else data['writeCallsMs'])[i] if exact else None
   start=s['startEpochMillis'];end=start+total;gap=max(0,(outer or total)-total)
   gc=[g for g in gcs if overlaps(start,end,g['startEpochMillis'],g['endEpochMillis'])]
   checkpoint=[probe for probe in data['checkpoints'] if overlaps(start,end,probe['startEpochMillis'],probe['startEpochMillis']+probe['totalMs'])]
   phases={k.removesuffix('Nanos')+'Ms':s[k]/1e6 for k in ('connectionNanos','statementNanos','commitNanos','coordinatorNanos','otherNanos')}
   dominant=max(phases,key=phases.get)
   events.append(dict(kind=s['kind'],sampleIndex=i,startEpochMillis=start,totalMs=total,outerMs=outer,**phases,dominantPhase=dominant,
       gcCoreOverlap=gc,checkpointCoreOverlap=checkpoint,
       gcOuterEnvelopeOverlap=[g for g in gcs if overlaps(start-gap,start+max(total,outer or total),g['startEpochMillis'],g['endEpochMillis'])]))
  phaseStats={}
  for key,selector in [('reads',lambda s:s['kind']=='READ'),('writes',lambda s:s['kind']!='READ')]:
   chosen=[s for s in samples if selector(s)]
   phaseStats[key]={k.removesuffix('Nanos')+'Ms':percentile([s[k]/1e6 for s in chosen]) for k in ('totalNanos','connectionNanos','statementNanos','commitNanos','coordinatorNanos','otherNanos')}
  extremes=[]
  for field in ('totalMs','outerMs','connectionMs','statementMs','commitMs','otherMs'):
   for kind in ('READ','WRITE'):
    eligible=[e for e in events if (e['kind']=='READ')==(kind=='READ') and e[field] is not None]
    if eligible:
     event=max(eligible,key=lambda e:e[field])
     if event not in extremes:extremes.append(event)
  long=[e for e in events if max(e['totalMs'],e['outerMs'] or 0)>=a.threshold_ms]
  tails=[e for e in events if max(e['totalMs'],e['outerMs'] or 0)>25]
  first=min(s['startEpochMillis'] for s in samples);last=max(s['startEpochMillis']+s['totalNanos']/1e6 for s in samples)
  result['phases'][mode]=dict(rawSamples=str(raw),rawSha256=digest(raw),measurement=observed,outerMappingExact=exact,phaseStats=phaseStats,
       thresholdEvents=long,over25msEvents=tails,extremes=extremes,checkpointProbes=data['checkpoints'],
       gcPausesInWindow=[g for g in gcs if overlaps(first,last,g['startEpochMillis'],g['endEpochMillis'])])
 out['runs'].append(result)
print(json.dumps(out,indent=2))
