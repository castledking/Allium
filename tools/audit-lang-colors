#!/usr/bin/env python3
"""List uncolored standalone language entries (requires PyYAML). Inline labels are excluded."""
import argparse,re,sys
from pathlib import Path
import yaml
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('files',nargs='+',type=Path)
p.add_argument('--include-labels',action='store_true')
a=p.parse_args()
color=re.compile(r'&(?:[0-9a-fk-or]|#[0-9a-f]{6})|§[0-9a-fk-or]|<[^>]+>',re.I)
def entries(value,key=''):
    if isinstance(value,dict):
        if 'text' in value:yield from entries(value['text'],key)
        else:
            for k,v in value.items():
                if k not in ('sound','volume','pitch'):yield from entries(v,f'{key}.{k}' if key else str(k))
    elif isinstance(value,list):
        for item in value:yield from entries(item,key)
    elif isinstance(value,str) and not value.lstrip().lower().startswith('[sound]'):
        yield key,value
bad=0
for path in a.files:
    data=yaml.safe_load(path.read_text());found=[]
    for key,text in entries(data):
        if not a.include_labels and key=='messaging.console-name':continue
        if text.strip() and not color.search(text) and '{prefix}' not in text:found.append((key,text))
    print(f'{path}: {len(found)} uncolored standalone entries')
    for key,text in found:print(f'  {key}: {text}')
    bad+=len(found)
sys.exit(bool(bad))
